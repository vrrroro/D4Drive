# Server
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=d4drive
DB_CONNECTION_LIMIT=10
# A hosted MySQL (Aiven) requires TLS. On the server, DB_SSL_CA is the
# provider's CA certificate in PEM; for `npm run db:setup -- --env <file>`,
# DB_SSL_CA_FILE is the path to that .pem file. Leave both empty locally.
DB_SSL_CA=
DB_SSL_CA_FILE=

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=8

# The car advisor (POST /api/advisor) runs a language model locally with
# Ollama (ollama.com): install it, then `ollama pull qwen2.5:3b`. Both are
# optional; the defaults below are used when empty. If Ollama is not
# running, the advisor says it is off and the rest of the site is unaffected.
# Hosted without a local Ollama (Vercel): OLLAMA_HOST=https://ollama.com,
# a cloud model with tool calling (beam is on the free tier), and an API key
# from ollama.com.
OLLAMA_HOST=
OLLAMA_MODEL=
OLLAMA_API_KEY=
